# Optional override for a user/organization Pages URL.
SITE_URL=https://YOUR_GITHUB_USER.github.io
# Optional when the repository name differs from the GitHub Actions context.
BASE_PATH=/world-yesterday
# Optional absolute path when `codex` is not discoverable on PATH.
CODEX_EXECUTABLE=codex
# Default for news verification; use xhigh only for unusually difficult days.
CODEX_REASONING_EFFORT=high
