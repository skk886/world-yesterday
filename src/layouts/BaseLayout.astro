---
import "../styles/global.css";

type Props = { title?: string; description?: string; current?: "latest" | "journal" | "archive" | "method" };
const { title = "昨日世界 / World Yesterday", description = "一份以来源和核验为中心的中英双语全球新闻简报。", current } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (route: string) => `${base}${route.replace(/^\//, "")}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1ede3" />
    <link rel="icon" type="image/svg+xml" href={href("favicon.svg")} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="masthead">
        <div class="masthead__meta">Source-first daily brief<br />Asia/Shanghai · UTC+8</div>
        <a class="masthead__title" href={href("")}><strong>昨日世界</strong><span>World Yesterday</span></a>
        <nav class="masthead__nav" aria-label="主导航">
          <a href={href("")} aria-current={current === "latest" ? "page" : undefined}>最新</a>
          <a href={href("journal/")} aria-current={current === "journal" ? "page" : undefined}>期刊精选</a>
          <a href={href("archive/")} aria-current={current === "archive" ? "page" : undefined}>归档</a>
          <a href={href("method/")} aria-current={current === "method" ? "page" : undefined}>方法</a>
        </nav>
      </header>
      <main><slot /></main>
      <footer class="site-footer"><span>昨日世界只发布原创摘要与原文链接，不转载新闻正文或图片。</span><span>Built as a static public record.</span></footer>
    </div>
  </body>
</html>
