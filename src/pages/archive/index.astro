---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmptyState from "../../components/EmptyState.astro";
import { getMissingEditionDates, loadEditions } from "../../lib/data";
import { formatEditionDate } from "../../lib/dates";
const editions = loadEditions();
const missingDates = getMissingEditionDates(editions);
const base = import.meta.env.BASE_URL;
const href = (route: string) => `${base}${route.replace(/^\//, "")}`;
---
<BaseLayout title="日期归档 · 昨日世界" current="archive">
  <header class="edition-hero">
    <div><p class="edition-hero__kicker">Permanent daily archive</p><h1>日期归档</h1></div>
    <div class="edition-hero__right"><p>共 {editions.length} 期正式日报。每期保存当时可核验的摘要和原始来源。</p><p>历史页面不会静默改写；需要纠正时，应保留更新时间与来源变化。</p></div>
  </header>
  {missingDates.length > 0 && <section><div class="section-heading"><h2>待补日期</h2><p>Captured, not yet edited</p></div><div class="missing-list">{missingDates.map((date) => <span>{date}</span>)}</div></section>}
  {editions.length ? (
    <div class="archive-grid">
      {editions.map((edition) => {
        const date = formatEditionDate(edition.date);
        return <a class="archive-card" href={href(`${edition.date}/`)}><time datetime={edition.date}>{edition.date}</time><h2>{date.zh}</h2><p>{edition.items.length} 个事件 · {edition.metrics.verifiedCount} 已核验 · {edition.metrics.pendingCount} 待核实</p></a>;
      })}
    </div>
  ) : <EmptyState expectedDate="尚无归档" />}
</BaseLayout>
