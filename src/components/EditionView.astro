---
import type { Edition } from "../lib/schema";
import { categories, categoryLabels } from "../lib/schema";
import { formatEditionDate } from "../lib/dates";
import NewsCard from "./NewsCard.astro";
type Props = { edition: Edition };
const { edition } = Astro.props;
const dateLabel = formatEditionDate(edition.date);
const verified = edition.items.filter((item) => item.verificationStatus === "verified");
const pending = edition.items.filter((item) => item.verificationStatus === "pending");
---

<header class="edition-hero">
  <div><p class="edition-hero__kicker">Daily edition · {edition.status === "complete" ? "完整期" : "部分发布"}</p><h1>{dateLabel.zh}</h1></div>
  <div class="edition-hero__right">
    <p lang="en"><strong>{dateLabel.en}</strong><br />{edition.items.length} events · {verified.length} verified · {pending.length} pending</p>
    <p>按北京时间整理昨日发布或实质更新的全球新闻。热度用于发现，来源与交叉核验决定是否发布。</p>
  </div>
</header>
<div class="filters" aria-label="栏目筛选">
  <span class="filters__label">Filter / 栏目</span>
  <button class="filter-button" type="button" data-filter="all" aria-pressed="true">全部 {edition.items.length}</button>
  {categories.map((category) => {
    const count = edition.items.filter((item) => item.category === category).length;
    return count ? <button class="filter-button" type="button" data-filter={category} aria-pressed="false">{categoryLabels[category].zh} {count}</button> : null;
  })}
</div>
<section aria-labelledby="verified-heading">
  <div class="section-heading"><h2 id="verified-heading">已核验事件</h2><p>Verified events · ranked by impact</p></div>
  <div class="news-list">{verified.map((item) => <NewsCard item={item} />)}</div>
</section>
{pending.length > 0 && (
  <section aria-labelledby="pending-heading">
    <div class="section-heading"><h2 id="pending-heading">待核实观察</h2><p>Pending · not part of the verified ranking</p></div>
    <div class="news-list">{pending.map((item) => <NewsCard item={item} />)}</div>
  </section>
)}
<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const cards = [...document.querySelectorAll<HTMLElement>("[data-category]")];
  for (const button of buttons) {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;
      for (const current of buttons) current.setAttribute("aria-pressed", String(current === button));
      for (const card of cards) card.hidden = filter !== "all" && card.dataset.category !== filter;
    });
  }
</script>
